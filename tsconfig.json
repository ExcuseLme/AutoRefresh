{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "jsx": "react-jsx",
    "types": ["chrome", "node"]
  },
  "include": [".wxt/wxt.d.ts", "src/**/*", "wxt.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", ".output", "dist"]
}
